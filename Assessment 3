def trains_at(station, day):
    found = []

    for number, info in trains.items():
        if day in info["days"]:
            for stop, arrival, departure in info["stops"]:
                if stop == station:
                    found.append(
                        (departure, number, info["name"])
                    )

    return sorted(found, key=lambda row: row[0])


