def frequencies(texts, stop):
    counts = {}

    for text in texts:
        for word in text.lower().split():
            word = word.strip(".,!?;:")

            if word and word not in stop:
                counts[word] = counts.get(word, 0) + 1

    return counts


def top(counts, k):
    return sorted(
        counts.items(),
        key=lambda item: (-item[1], item[0])
    )[:k]


print(top(frequencies(calls, STOP), 3))
