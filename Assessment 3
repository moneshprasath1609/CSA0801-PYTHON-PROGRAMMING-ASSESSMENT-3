def normalise_phone(phone):
    digits = "".join(
        ch for ch in phone if ch.isdigit()
    )

    if digits.startswith("91") and len(digits) == 12:
        digits = digits[2:]

    return digits


def merge_contacts(contact_lists):
    merged = {}

    for source in contact_lists:
        for contact in source:
            phones = {
                normalise_phone(p)
                for p in contact.get("phones", [])
            }

            phones.discard("")

            emails = {
                e.strip().lower()
                for e in contact.get("emails", [])
                if e.strip()
            }

            key = next(iter(sorted(phones)), None)

            if key is None:
                key = "name:" + " ".join(
                    contact.get("name", "").lower().split()
                )

            if key not in merged:
                merged[key] = {
                    "name": contact.get("name", ""),
                    "phones": set(),
                    "emails": set()
                }

            merged[key]["phones"].update(phones)
            merged[key]["emails"].update(emails)

    return list(merged.values())


