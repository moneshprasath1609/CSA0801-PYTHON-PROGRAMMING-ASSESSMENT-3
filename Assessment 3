def moving_naive(a, window=7):
    return [
        sum(a[i:i+window])/window
        for i in range(len(a)-window+1)
    ]


def moving_running(a, window=7):
    if len(a) < window:
        return []

    total = sum(a[:window])
    out = [total/window]

    for i in range(window, len(a)):
        total += a[i] - a[i-window]
        out.append(total/window)

    return out
